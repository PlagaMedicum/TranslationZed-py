@startuml
skinparam linetype ortho
package GUI {
  [main_window]
  [entry_model]
  [delegates]
  [preferences_dialog]
}
package Core {
  [project_session]
  [file_workflow]
  [conflict_service]
  [search_replace_service]
  [qa_service]
  [tm_workflow_service]
  [languagetool]
}
package Storage {
  [status_cache]
  [en_hash_cache]
  [tm_store]
  [parser]
  [saver]
}
[main_window] --> [project_session]
[main_window] --> [file_workflow]
[main_window] --> [search_replace_service]
[main_window] --> [qa_service]
[main_window] --> [tm_workflow_service]
[main_window] --> [languagetool]
[file_workflow] --> [conflict_service]
[file_workflow] --> [status_cache]
[file_workflow] --> [parser]
[file_workflow] --> [saver]
[tm_workflow_service] --> [tm_store]
@enduml
