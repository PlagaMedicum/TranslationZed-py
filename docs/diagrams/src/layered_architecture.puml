@startuml
skinparam linetype ortho
actor User
package "GUI Layer" {
  [main_window]
  [entry_model]
  [delegates]
}
package "Core Services" {
  [project_session]
  [file_workflow]
  [search_replace_service]
  [tm_workflow_service]
}
package "Domain/Infrastructure" {
  [parser/saver]
  [status_cache]
  [tm_store]
}
User --> [main_window]
[main_window] --> [project_session]
[main_window] --> [file_workflow]
[main_window] --> [search_replace_service]
[main_window] --> [tm_workflow_service]
[file_workflow] --> [parser/saver]
[file_workflow] --> [status_cache]
[tm_workflow_service] --> [tm_store]
@enduml
