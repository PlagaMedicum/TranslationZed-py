}

MainWindow --> TranslationModel
MainWindow --> FsModel
MainWindow --> PreferencesDialog
MainWindow --> main_window_panel_helpers
MainWindow --> main_window_en_diff_helpers
MainWindow --> status_header
MainWindow --> table_header
