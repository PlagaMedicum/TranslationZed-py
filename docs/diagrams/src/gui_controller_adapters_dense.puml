  class TranslationModel
  class FsModel
  class PreferencesDialog
}

package "GUI helper adapters" {
  class main_window_panel_helpers
  class main_window_en_diff_helpers
  class status_header
  class table_header
  class languagetool_adapter
  class qa_async
}

package "Core service entry points" {
