{
  "version": 1,
  "default_fast_targets": [],
  "full_targets": [
    "scripts/test_a31_manual.sh",
    "scripts/test_cr_v09.sh",
    "scripts/test_qa_v09.sh",
    "scripts/test_search_a37.sh",
    "scripts/test_src_a29.sh",
    "scripts/test_status_a34.sh",
    "scripts/test_tmq_v09.sh",
    "scripts/test_tmw_v09.sh",
    "scripts/test_tzp_a30.sh"
  ],
  "rules": [
    {
      "id": "manual-framework",
      "description": "Manual scenario framework/runtime and contract files",
      "match_globs": [
        "scripts/clean_manual_artifacts.py",
        "scripts/release_evidence_*.py",
        "scripts/ui_manual_*",
        "tests/manual_scenarios/**",
        "tests/test_clean_manual_artifacts.py",
        "tests/test_manual_scenario*.py",
        "tests/test_release_evidence_*.py",
        "tests/test_ui_manual_*.py",
        "translationzed_py/gui/manual_scenario_*.py"
      ],
      "targets_fast": [
        "scripts/test_a31_manual.sh"
      ],
      "targets_full": [
        "scripts/test_a31_manual.sh"
      ]
    },
    {
      "id": "qa",
      "description": "QA rule model, async orchestration, and panel integration",
      "match_globs": [
        "translationzed_py/core/qa*.py",
        "translationzed_py/gui/qa*.py",
        "tests/test_qa*.py",
        "tests/test_gui_qa_panel.py"
      ],
      "targets_fast": [
        "scripts/test_qa_v09.sh"
      ],
      "targets_full": [
        "scripts/test_qa_v09.sh"
      ]
    },
    {
      "id": "tmq",
      "description": "TM ranking/scoring/explainability core",
      "match_globs": [
        "translationzed_py/core/tm_query*.py",
        "translationzed_py/core/tm_store*.py",
        "tests/test_tm_query*.py",
        "tests/test_tm_store*.py",
        "tests/test_tm_ranking_corpus.py"
      ],
      "targets_fast": [
        "scripts/test_tmq_v09.sh"
      ],
      "targets_full": [
        "scripts/test_tmq_v09.sh"
      ]
    },
    {
      "id": "tmw",
      "description": "TM workflow grouping/apply UX integration",
      "match_globs": [
        "translationzed_py/core/tm_workflow_service.py",
        "tests/test_tm_workflow_service.py",
        "tests/test_gui_tm_preferences.py"
      ],
      "targets_fast": [
        "scripts/test_tmw_v09.sh"
      ],
      "targets_full": [
        "scripts/test_tmw_v09.sh"
      ]
    },
    {
      "id": "cr",
      "description": "Crash/session-resume startup flow",
      "match_globs": [
        "translationzed_py/core/project_session.py",
        "translationzed_py/core/session_resume.py",
        "translationzed_py/gui/main_window_bootstrap*.py",
        "tests/test_project_session.py",
        "tests/test_main_window_bootstrap_helpers.py"
      ],
      "targets_fast": [
        "scripts/test_cr_v09.sh"
      ],
      "targets_full": [
        "scripts/test_cr_v09.sh"
      ]
    },
    {
      "id": "source-reference",
      "description": "Source-reference direct-mode selection and GUI binding",
      "match_globs": [
        "translationzed_py/core/source_reference*.py",
        "translationzed_py/gui/source_reference*.py",
        "tests/test_source_reference*.py"
      ],
      "targets_fast": [
        "scripts/test_src_a29.sh"
      ],
      "targets_full": [
        "scripts/test_src_a29.sh"
      ]
    },
    {
      "id": "tzp-writeback",
      "description": "TZP comment write-back pipeline",
      "match_globs": [
        "translationzed_py/core/tzp_comment_policy.py",
        "translationzed_py/core/parser.py",
        "translationzed_py/core/saver.py",
        "translationzed_py/core/file_workflow.py",
        "tests/test_tzp_comment_policy.py",
        "tests/test_parser_features.py",
        "tests/test_saver.py",
        "tests/test_file_workflow.py"
      ],
      "targets_fast": [
        "scripts/test_tzp_a30.sh"
      ],
      "targets_full": [
        "scripts/test_tzp_a30.sh"
      ]
    },
    {
      "id": "search-replace",
      "description": "Search/replace planning and UI confirmation flow",
      "match_globs": [
        "translationzed_py/core/search_replace_service.py",
        "translationzed_py/gui/main_window*.py",
        "translationzed_py/gui/dialogs.py",
        "tests/test_search_replace_service.py",
        "tests/test_main_window_replace_merge_clipboard.py",
        "tests/test_gui_service_adapters.py",
        "tests/test_gui_dialogs.py"
      ],
      "targets_fast": [
        "scripts/test_search_a37.sh"
      ],
      "targets_full": [
        "scripts/test_search_a37.sh"
      ]
    },
    {
      "id": "status-triage",
      "description": "Status-bar mixed-selection indicator and triage helpers",
      "match_globs": [
        "translationzed_py/gui/main_window_panel_helpers.py",
        "tests/test_main_window_cache_replace_helpers.py"
      ],
      "targets_fast": [
        "scripts/test_status_a34.sh"
      ],
      "targets_full": [
        "scripts/test_status_a34.sh"
      ]
    }
  ]
}
